<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/meditime_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- App Brand Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_med_pill"
                android:contentDescription="MediTime Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDiTime — Medicine Alarm"
                android:textColor="@color/meditime_teal_light"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Pulsing Alarm Bell & Current Time -->
        <ImageView
            android:id="@+id/iv_alarm_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_alarm_bell"
            android:layout_marginBottom="12dp"
            android:contentDescription="Ringing Alarm" />

        <TextView
            android:id="@+id/tv_current_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00 PM"
            android:textColor="@color/meditime_text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Medicine Detail Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_alarm_card"
            android:padding="22dp"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ঔষধ খাওয়ার সময় হয়েছে"
                android:textColor="@color/meditime_teal_light"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_medicine_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textColor="@color/meditime_text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_dosage_instruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500 mg • খাওয়ার আগে / Before Breakfast"
                android:textColor="@color/meditime_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="নির্ধারিত সময়: "
                    android:textColor="@color/meditime_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_scheduled_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:00 PM"
                    android:textColor="@color/meditime_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 1. TAKEN (খেয়েছি) -->
            <Button
                android:id="@+id/btn_taken"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="খেয়েছি  (TAKEN)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_taken"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- 2. SNOOZE (পরে খাব) -->
                <Button
                    android:id="@+id/btn_snooze"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="পরে খাব  (SNOOZE)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_snooze"
                    android:layout_marginEnd="6dp" />

                <!-- 3. STOP (অ্যালার্ম বন্ধ) -->
                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="বন্ধ  (STOP)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_stop"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- 4. SKIP (এবার খাব না) -->
            <Button
                android:id="@+id/btn_skip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="এবার খাব না  (SKIP)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_skip"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
