<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="14dp">

    <!-- Header: MediTime + Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_med_pill"
            android:contentDescription="MediTime" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDiTime"
            android:textColor="@color/meditime_teal_light"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/meditime_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Title & Progress Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Medicine"
            android:textColor="@color/meditime_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_tv_progress_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 2 / 5 Taken ]"
            android:textColor="@color/color_taken"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stats Row: Taken | Remaining | Missed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- Taken -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taken"
                android:textColor="@color/meditime_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_tv_taken_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="@color/color_taken"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Remaining -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining"
                android:textColor="@color/meditime_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_tv_remaining_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="@color/color_warning"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Missed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Missed"
                android:textColor="@color/meditime_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_tv_missed_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/color_skip"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Next Medicine Callout Box -->
    <LinearLayout
        android:id="@+id/widget_next_med_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_alarm_card"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Medicine:"
            android:textColor="@color/meditime_text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_tv_next_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="G — 500"
                android:textColor="@color/meditime_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_tv_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:30 PM"
                android:textColor="@color/meditime_teal_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Status Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_alarm_bell"
            android:contentDescription="Status" />

        <TextView
            android:id="@+id/widget_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All reminders active"
            android:textColor="@color/meditime_teal_light"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginStart="5dp" />
    </LinearLayout>
</LinearLayout>
